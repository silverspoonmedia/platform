{
    "name": "silverspoonmedia/platform",
    "description": "Silverspoon shared kernel: Support, the Identity hub, HTTP glue, repositories and the platform providers.",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.4",
    "homepage": "https://github.com/silverspoonmedia/platform",
    "support": {
        "source": "https://github.com/silverspoonmedia/platform"
    },
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.0",
        "chillerlan/php-qrcode": "^4.4",
        "fruitcake/php-cors": "^1.3",
        "laravel/framework": "^13.0",
        "league/flysystem-aws-s3-v3": "3.*",
        "nesbot/carbon": "^3.0",
        "php-open-source-saver/jwt-auth": "^2.9",
        "pragmarx/google2fa-laravel": "^3.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-permission": "^8.0",
        "symfony/console": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/mime": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\Support\\": "src/Support/",
            "App\\Domain\\Identity\\": "src/Domain/Identity/",
            "App\\Console\\": "src/Console/",
            "App\\Http\\": "src/Http/",
            "App\\Repositories\\": "src/Repositories/",
            "App\\Providers\\": "src/Providers/",
            "App\\Traits\\": "src/Traits/",
            "App\\Rules\\": "src/Rules/",
            "App\\Exceptions\\": "src/Exceptions/",
            "App\\Domain\\Identity\\Tests\\": "tests/Identity/"
        },
        "files": [
            "src/Support/Settings/helpers.php"
        ]
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Providers\\EncryptionServiceProvider",
                "App\\Providers\\ProductServiceProvider",
                "App\\Providers\\DomainAccessServiceProvider",
                "App\\Providers\\SettingsServiceProvider",
                "App\\Providers\\Domain\\IdentityServiceProvider",
                "App\\Providers\\ApiExceptionEnvelopeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
